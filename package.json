{
  "name": "planwise",
  "version": "0.1.0",
  "private": true,
  "description": "Planwise - CRM SaaS orienté opérations terrain (monorepo TypeScript).",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "format:check:changed": "node scripts/prettier-check-changed.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run build:shared && node scripts/typecheck-all.mjs",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run e2e -w @planwise/frontend",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build --workspace @planwise/shared --if-present && npm run build --workspace @planwise/telemetry --if-present",
    "e2e": "npm run e2e --workspace @planwise/frontend --if-present",
    "e2e:live": "npm run e2e:live --workspace @planwise/frontend --if-present",
    "pwa:preview": "npm run pwa:preview -w @planwise/frontend",
    "backend": "docker compose up -d --wait && npm run backend:run",
    "monitoring:local": "docker compose --profile monitoring up -d --wait && node scripts/monitoring-local-verify.mjs",
    "monitoring:local:down": "docker compose --profile monitoring down",
    "backend:monitoring": "npm run monitoring:local",
    "backend:gateway": "npm run start:dev -w @planwise/api-gateway",
    "backend:worker": "npm run start:worker -w @planwise/api-gateway",
    "backend:notifications": "npm run start:notifications -w @planwise/api-gateway",
    "backend:free-ports": "node scripts/free-backend-ports.mjs",
    "backend:run": "npm run build:shared && wait-on -t 60000 tcp:localhost:27017 && node scripts/free-backend-ports.mjs && node scripts/backend-run.mjs",
    "backend:down": "docker compose down",
    "datadog:up": "docker compose --profile datadog up -d --wait",
    "datadog:down": "docker rm -f planwise-datadog-agent 2>/dev/null || true",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "concurrently": "^9.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.0.0",
    "wait-on": "^8.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "eslint-config-next": {
      "@typescript-eslint/eslint-plugin": "8.59.3",
      "@typescript-eslint/parser": "8.59.3"
    }
  }
}
