// Alloy — collecte des logs Docker (stack Planwise) → Loki.
// Doc : https://grafana.com/docs/alloy/latest/collect/logs-in-kubernetes/ (équivalent Docker)

discovery.docker "containers" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "5s"
}

discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "compose_service"
	}

	rule {
		source_labels = ["__meta_docker_container_log_stream"]
		target_label  = "stream"
	}

	// Keep OR :
	// - container_name planwise-* (mongo, caddy, monitoring…)
	// - image *planwise-* (microservices Compose sans container_name fixe,
	//   ex. deploy-cases-service-1 → ghcr.io/…/planwise-cases-service:tag)
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/planwise-.*"
		target_label  = "__tmp_keep"
		replacement   = "yes"
	}

	rule {
		source_labels = ["__meta_docker_container_image"]
		regex         = ".*planwise-.*"
		target_label  = "__tmp_keep"
		replacement   = "yes"
	}

	rule {
		source_labels = ["__tmp_keep"]
		regex         = "yes"
		action        = "keep"
	}

	// Évite la boucle logs Loki/Alloy.
	rule {
		source_labels = ["container"]
		regex         = "planwise-(loki|alloy)(-local)?"
		action        = "drop"
	}
}

loki.source.docker "containers" {
	host          = "unix:///var/run/docker.sock"
	targets       = discovery.relabel.containers.output
	labels        = {
		"job" = "docker",
	}
	relabel_rules = discovery.relabel.containers.rules
	forward_to    = [loki.write.default.receiver]
}

loki.write "default" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
