# Copier vers `.env` : cp .env.example .env
#
# ── Mongo ────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/planwise-billing
#
# Migrations (migrate-mongo) :
#   npm run migrate:status -w @planwise/billing-service
#   npm run migrate:up     -w @planwise/billing-service
#   npm run migrate:down   -w @planwise/billing-service
# Elles sont aussi appliquées automatiquement au démarrage du service.

PORT=3014

# Dossier cases (titre / contexte, pas d’écriture obligatoire)
CASES_SERVICE_URL=http://localhost:3004

# E-mail transactionnel (envoi de facture avec PDF)
NOTIFICATIONS_SERVICE_URL=http://localhost:3010
